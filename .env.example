# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://mgsf:CHANGE_ME@localhost:5432/mgsf
DB_POOL_MAX=10

# ── Auth ─────────────────────────────────────────────────
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# 1 = admins also need an e-mail OTP when logging in (old login flow)
ADMIN_LOGIN_OTP=1
# Secret /feature-control page (switch features on / off per trust). Empty = page is off (404).
# 12+ characters, keep it only with the developer:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
CONTROL_KEY=

# ── E-mail (OTP, certificates, receipts) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MGSF <no-reply@example.com>"

# ── File storage ─────────────────────────────────────────
# local = save on the server disk (UPLOAD_DIR); r2 = Cloudflare R2 (recommended)
STORAGE=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=https://your-domain.in
UPLOAD_MAX_MB=8
# for STORAGE=r2
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mgsf
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://files.your-domain.in

# ── Push notifications (Expo) — optional ─────────────────
EXPO_ACCESS_TOKEN=

# ── Docker (docker-compose.yml) ──────────────────────────
POSTGRES_PASSWORD=CHANGE_ME
DOMAIN=api.your-domain.in

# ── Tests only (a separate empty database — tests wipe it) ──
TEST_DATABASE_URL=postgresql://mgsf:CHANGE_ME@localhost:5432/mgsf_test
